          "shape": "process"
        },
        {
          "id": "check",
          "name": "满足借阅条件？",
          "shape": "decision"
        },
        {
          "id": "save",
          "name": "创建借阅记录",
          "shape": "process"
        },
        {
          "id": "reject",
          "name": "提示不可借阅",
          "shape": "process"
        },
        {
          "id": "finish",
          "name": "结束",
          "shape": "terminal"
        }
      ],
      "relations": [
        {
          "id": "f1",
          "source": "start",
          "target": "select",
          "label": ""
        },
        {
          "id": "f2",
          "source": "select",
          "target": "check",
          "label": ""
        },
        {
          "id": "f3",
          "source": "check",
          "target": "save",
          "label": "是"
        },
        {
          "id": "f4",
          "source": "check",
          "target": "reject",
          "label": "否"
        },
        {
          "id": "f5",
          "source": "save",
          "target": "finish",
          "label": ""
        },
        {
          "id": "f6",
          "source": "reject",
          "target": "finish",
          "label": ""
