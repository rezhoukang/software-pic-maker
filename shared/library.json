        },
        {
          "id": "manage",
          "name": "管理馆藏"
        },
        {
          "id": "review",
          "name": "处理借还"
        },
        {
          "id": "eligibility",
          "name": "校验借阅资格"
        },
        {
          "id": "renew",
          "name": "续借图书"
        }
      ],
      "relations": [
        {
          "id": "u1",
          "source": "reader",
          "target": "search",
          "label": ""
        },
        {
          "id": "u2",
          "source": "reader",
          "target": "borrow",
          "label": ""
        },
        {
          "id": "u3",
          "source": "reader",
          "target": "history",
          "label": ""
        },
        {
          "id": "u4",
          "source": "admin",
          "target": "manage",
          "label": ""
        },
        {
          "id": "u5",
          "source": "admin",
          "target": "review",
          "label": ""
        },
        {
          "id": "u6",
          "source": "borrow",
          "target": "eligibility",
          "label": "",
          "kind": "include"
        },
        {
          "id": "u7",
          "source": "renew",
          "target": "borrow",
          "label": "",
          "kind": "extend"
        }
      ]
    },
    "view": {
      "theme": "blue",
      "direction": "TB",
      "positions": {}
    }
