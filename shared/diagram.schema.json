{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EZ软图图表格式 v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
    },
    "type": {
      "enum": [
        "er",
        "table",
        "class",
        "flowchart",
        "architecture",
        "structure",
        "usecase",
        "sequence"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "model": {
      "type": "object"
    },
    "view": {
      "type": "object",
      "properties": {
        "theme": {
          "enum": [
            "blue",
            "mono",
            "sage"
          ]
        },
        "direction": {
          "enum": [
            "LR",
            "TB"
          ]
        },
        "positions": {
          "type": "object",
          "maxProperties": 1000,
          "additionalProperties": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 20000
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 20000
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "theme",
        "direction",
        "positions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "model",
    "view"
  ],
  "additionalProperties": false,
  "$defs": {
    "field": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "type": {
          "type": "string",
          "maxLength": 60
        },
        "primary": {
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          },
          "minItems": 0,
          "maxItems": 50
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "maxItems": 20
        },
        "shape": {
          "enum": [
            "process",
            "decision",
            "terminal",
            "database",
            "service",
            "client"
          ]
        },
        "role": {
          "type": "string",
          "maxLength": 80
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "label": {
          "type": "string",
          "maxLength": 120
        },
        "kind": {
          "enum": [
            "association",
            "include",
            "extend",
            "dependency",
            "inheritance",
            "return"
          ]
        },
        "source_cardinality": {
          "enum": [
            "1",
            "0..1",
            "0..N",
            "1..N",
            "N",
            "M",
            "*"
          ]
        },
        "target_cardinality": {
          "enum": [
            "1",
            "0..1",
            "0..N",
            "1..N",
            "N",
            "M",
            "*"
          ]
        }
      },
      "required": [
        "id",
        "source",
        "target"
      ],
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "kind": {
          "enum": [
            "call",
            "return"
          ]
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "label"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "er"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "model": {
            "type": "object",
            "properties": {
              "entities": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/item"
                },
                "minItems": 1,
                "maxItems": 80
              },
              "relations": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/relation"
                },
                "minItems": 0,
                "maxItems": 160
              }
            },
            "required": [
              "entities",
              "relations"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "table"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "model": {
            "type": "object",
            "properties": {
              "entities": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/item"
                },
                "minItems": 1,
                "maxItems": 80
              },
              "relations": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/relation"
                },
                "minItems": 0,
                "maxItems": 160
              }
            },
            "required": [
              "entities",
              "relations"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "class"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "model": {
            "type": "object",
            "properties": {
              "classes": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/item"
                },
                "minItems": 1,
                "maxItems": 80
              },
              "relations": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/relation"
                },
                "minItems": 0,
                "maxItems": 160
              }
            },
            "required": [
              "classes",
              "relations"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "flowchart"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "model": {
            "type": "object",
            "properties": {
              "nodes": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/item"
                },
                "minItems": 1,
                "maxItems": 80
              },
              "relations": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/relation"
                },
                "minItems": 0,
                "maxItems": 160
              }
            },
            "required": [
              "nodes",
              "relations"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "architecture"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "model": {
            "type": "object",
            "properties": {
              "nodes": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/item"
                },
                "minItems": 1,
                "maxItems": 80
              },
              "relations": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/relation"
                },
                "minItems": 0,
                "maxItems": 160
              }
            },
            "required": [
              "nodes",
              "relations"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "structure"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "model": {
            "type": "object",
            "properties": {
              "nodes": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/item"
                },
                "minItems": 1,
                "maxItems": 80
              },
              "relations": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/relation"
                },
                "minItems": 0,
                "maxItems": 160
              }
            },
            "required": [
              "nodes",
              "relations"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "usecase"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "model": {
            "type": "object",
            "properties": {
              "system_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "actors": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/item"
                },
                "minItems": 1,
                "maxItems": 12
              },
              "use_cases": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/item"
                },
                "minItems": 1,
                "maxItems": 40
              },
              "relations": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/relation"
                },
                "minItems": 0,
                "maxItems": 100
              }
            },
            "required": [
              "system_name",
              "actors",
              "use_cases",
              "relations"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "sequence"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "model": {
            "type": "object",
            "properties": {
              "participants": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/item"
                },
                "minItems": 2,
                "maxItems": 12
              },
              "messages": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/message"
                },
                "minItems": 1,
                "maxItems": 100
              }
            },
            "required": [
              "participants",
              "messages"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
