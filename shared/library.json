  {
    "schema_version": "1.0",
    "id": "sequence-example",
    "type": "sequence",
    "title": "借阅交互时序图",
    "description": "按时间顺序展示一次借阅成功请求的参与者和消息。",
    "model": {
      "participants": [
        {
          "id": "reader",
          "name": "读者"
        },
        {
          "id": "page",
          "name": "借阅页面"
        },
        {
          "id": "service",
          "name": "借阅服务"
        },
        {
          "id": "db",
          "name": "数据库"
        }
      ],
      "messages": [
        {
          "id": "m1",
          "source": "reader",
          "target": "page",
          "label": "点击借阅",
          "kind": "call"
        },
        {
          "id": "m2",
          "source": "page",
          "target": "service",
          "label": "提交借阅请求",
          "kind": "call"
        },
        {
          "id": "m3",
          "source": "service",
          "target": "db",
          "label": "校验并写入借阅记录",
          "kind": "call"
        },
        {
          "id": "m4",
          "source": "db",
          "target": "service",
          "label": "返回处理结果",
          "kind": "return"
        },
        {
          "id": "m5",
          "source": "service",
          "target": "page",
          "label": "借阅成功",
          "kind": "return"
        },
        {
          "id": "m6",
          "source": "page",
          "target": "reader",
          "label": "展示成功提示",
          "kind": "return"
        }
      ]
    },
    "view": {
      "theme": "blue",
      "direction": "TB",
      "positions": {}
    }
  },
  {
    "schema_version": "1.0",
    "id": "class-example",
    "type": "class",
    "title": "借阅模块类图",
    "description": "属性和操作分栏展示；虚线箭头表示服务对实体的依赖。",
    "model": {
      "classes": [
        {
          "id": "service",
          "name": "BorrowService",
          "fields": [
            {
              "name": "- repository",
              "type": "LoanRepository"
            }
          ],
          "methods": [
            "+ borrow(readerId, bookId): Loan",
            "+ returnBook(loanId): void"
          ]
        },
        {
          "id": "book",
          "name": "Book",
          "fields": [
            {
              "name": "- id",
              "type": "int"
            },
            {
              "name": "- title",
              "type": "string"
            },
            {
              "name": "- status",
              "type": "string"
            }
          ],
          "methods": [
            "+ isAvailable(): bool"
          ]
        },
        {
          "id": "loan",
          "name": "Loan",
          "fields": [
            {
              "name": "- id",
              "type": "int"
            },
            {
              "name": "- borrowedAt",
              "type": "datetime"
            }
          ],
          "methods": [
            "+ close(): void"
          ]
        }
      ],
      "relations": [
        {
          "id": "c1",
          "source": "service",
          "target": "book",
          "label": "校验馆藏",
          "kind": "dependency"
        },
        {
          "id": "c2",
          "source": "service",
          "target": "loan",
          "label": "创建记录",
          "kind": "dependency"
        }
      ]
    },
    "view": {
      "theme": "blue",
      "direction": "LR",
      "positions": {}
    }
  },
