[
  {
    "schema_version": "1.0",
    "id": "er-example",
    "type": "er",
    "title": "图书借阅 · 概念 ER 图",
    "description": "用实体、属性和联系描述业务。图书按单本实体书理解，借阅联系涵盖历史记录。",
    "model": {
      "entities": [
        {
          "id": "reader",
          "name": "读者",
          "fields": [
            {
              "name": "读者编号",
              "type": "bigint",
              "primary": true
            },
            {
              "name": "姓名",
              "type": "varchar(100)"
            },
            {
              "name": "联系电话",
              "type": "varchar(20)"
            }
          ]
        },
        {
          "id": "book",
          "name": "图书",
          "fields": [
            {
              "name": "图书编号",
              "type": "bigint",
              "primary": true
            },
            {
              "name": "书名",
              "type": "varchar(100)"
            },
            {
              "name": "馆藏状态",
              "type": "varchar(20)"
            }
          ]
        },
        {
          "id": "category",
          "name": "分类",
          "fields": [
            {
              "name": "分类编号",
              "type": "bigint",
              "primary": true
            },
            {
              "name": "分类名称",
              "type": "varchar(100)"
            }
          ]
        }
      ],
      "relations": [
        {
          "id": "borrows",
          "source": "reader",
          "target": "book",
          "label": "借阅",
          "source_cardinality": "M",
          "target_cardinality": "N"
        },
        {
          "id": "belongs",
          "source": "book",
          "target": "category",
          "label": "归属",
          "source_cardinality": "N",
          "target_cardinality": "1"
        }
      ]
    },
    "view": {
      "theme": "blue",
      "direction": "LR",
      "positions": {}
    }
  },
  {
    "schema_version": "1.0",
    "id": "table-example",
    "type": "table",
    "title": "数据库表关系图",
    "description": "逻辑关联独立于数据库外键约束。每条借阅记录对应一名读者和一本图书。",
    "model": {
      "entities": [
        {
          "id": "reader",
          "name": "reader · 读者",
          "fields": [
            {
              "name": "id",
              "type": "bigint",
              "primary": true
            },
            {
              "name": "name",
              "type": "varchar(100)"
            },
            {
              "name": "phone",
              "type": "varchar(20)"
            }
          ]
        },
        {
          "id": "loan",
          "name": "loan · 借阅记录",
          "fields": [
            {
              "name": "id",
              "type": "bigint",
              "primary": true
            },
            {
              "name": "reader_id",
              "type": "bigint"
            },
            {
              "name": "book_id",
              "type": "bigint"
            },
            {
              "name": "borrowed_at",
              "type": "datetime"
            },
            {
              "name": "returned_at",
              "type": "datetime"
            }
          ]
        },
        {
          "id": "book",
          "name": "book · 图书",
          "fields": [
            {
              "name": "id",
              "type": "bigint",
              "primary": true
            },
            {
              "name": "title",
              "type": "varchar(100)"
            },
            {
              "name": "status",
              "type": "varchar(20)"
            }
          ]
        }
      ],
      "relations": [
        {
          "id": "reader-loan",
          "source": "reader",
          "target": "loan",
          "label": "reader_id",
          "source_cardinality": "1",
          "target_cardinality": "0..N"
        },
        {
          "id": "loan-book",
          "source": "loan",
          "target": "book",
          "label": "book_id",
          "source_cardinality": "0..N",
          "target_cardinality": "1"
        }
      ]
    },
    "view": {
      "theme": "blue",
      "direction": "LR",
      "positions": {}
    }
  },
  {
    "schema_version": "1.0",
    "id": "usecase-example",
